# Defaults use synthetic fixtures only. Do not add secrets to this file.
ASTERION_STATE_DIR=.asterion
# Optional live planning: set only after enabling a Converse-compatible model.
# AWS_REGION=us-east-1
# ASTERION_BEDROCK_MODEL_ID=<operator-selected-model-or-inference-profile>
# Optional HTTP OTLP receiver. Spans contain node names, not raw notes.
# ASTERION_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# API secrets are generated by scripts/serve.py for local use.
